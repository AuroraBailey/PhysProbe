# Copy to .env in the repository root. Fill only the providers you use.
# CLI arguments > existing environment > .env > script defaults.
# Empty values are ignored. No variable interpolation; quote values if needed.

# Doubao: one shared credential for all scripts.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Qwen/Wan native image API (different from the chat-compatible endpoint).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Qwen scene-audit / chat API:
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional: DASHSCOPE_API_KEY_0 through DASHSCOPE_API_KEY_3

# GLM scene audit.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Gemini scripts in this repository use Aihubmix.
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1

# Azure OpenAI: shared by GPT Image 1.5 and 2.0; select version via model arguments.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Runnable examples: paths relative to the repository root, or absolute paths.
# Used by python3 examples/run.py; --asset-root / --output-root override these.
EXAMPLE_ASSET_ROOT=examples/assets
EXAMPLE_OUTPUT_ROOT=outputs/examples/gpt-image-1.5

# Optional launcher paths. Set paths appropriate to the experiment being run.
# Python runners retain their path CLI arguments; supply them where required.
# Unified main/stress and ablation run/start/progress scripts use GT_ROOT and BASE_OUTPUT_DIR.
# Relative paths in these task scripts are resolved from the repository root.
# GT_ROOT=/path/to/benchmark_data/GT
# Metallic: --input-root must contain PBR-Rooms mainaxis/ and stresstest/.
# Other targets: --input-root contains openroomff_* / interiorverse_* folders.
# BASE_OUTPUT_DIR=/path/to/benchmark_outputs/my_run
# INPUT_DIR=/path/to/benchmark_data/images
# OUTPUT_DIR=/path/to/benchmark_outputs/my_run
# PYTHON_BIN=python3
